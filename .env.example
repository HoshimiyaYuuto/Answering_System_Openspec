PORT=3000
HOST=0.0.0.0
# 老師登入密碼。複製本檔為 .env 後改成自己的密碼；未設定時老師無法登入。
# 不要使用與其他服務相同的密碼，也不要把 .env 提交到 repository。
TEACHER_PASSWORD=replace-me
# Google 試算表寫回（選填）。只填服務帳號 JSON 金鑰檔的路徑，金鑰檔放在 repository 以外的位置，
# 例如 C:\Users\<使用者>\.secrets\answering-sheets.json；不要把金鑰內容貼進這裡或任何檔案。
# 未設定時寫回會回 503 SHEET_NOT_CONFIGURED，仍可使用「下載 xlsx」。
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
